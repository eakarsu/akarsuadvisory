DATABASE_URL=postgresql://advisory_user:replace_me@127.0.0.1:5432/advisory
BACKEND_PORT=3001
FRONTEND_PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=akarsu-advisory
JWT_AUDIENCE=akarsu-advisory-web
PUBLIC_TENANT_ID=akarsu
ADVISORY_ACTIVE_KEY_VERSION=v1
ADVISORY_DATA_KEYS_JSON={"v1":"replace-with-64-hex-characters"}
PUBLIC_APP_URL=https://advisory.example
CORS_ORIGIN=https://advisory.example
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=replace-with-approved-model
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=180000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME=Runtime Admin
PROVIDER_WEBHOOK_SECRETS_JSON={"calendar":"replace-32-plus","document_store":"replace-32-plus","messaging":"replace-32-plus","crm":"replace-32-plus"}
CALENDAR_BASE_URL=https://calendar.example/api/
CALENDAR_ACCESS_TOKEN=replace
DOCUMENT_STORE_BASE_URL=https://documents.example/api/
DOCUMENT_STORE_ACCESS_TOKEN=replace
MESSAGING_BASE_URL=https://messaging.example/api/
MESSAGING_ACCESS_TOKEN=replace
CRM_BASE_URL=https://crm.example/api/
CRM_ACCESS_TOKEN=replace
PROVIDER_TIMEOUT_MS=10000
ENABLE_GENERATED_FEATURES=false
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
